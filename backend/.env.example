# Non-secret config
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173

# Secrets — set these on your host's env var / secret manager (Render,
# Railway, Vercel, etc.), never commit real values. See docs/ENVIRONMENTS.md
# and docs/SECURITY_PRACTICES.md.
#
# FIREBASE_SERVICE_ACCOUNT_BASE64: base64-encode the service account JSON
# downloaded from Firebase Console > Project Settings > Service Accounts,
# e.g. `base64 -i serviceAccountKey.json | tr -d '\n'`. Required because
# this runs on a plain Node host with no ambient GCP identity.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_STORAGE_BUCKET=
GEMINI_API_KEY=
